{
  "name": "mg-studio",
  "version": "0.1.0",
  "private": true,
  "description": "MG 全链路工具包：声明式分镜编译 + 确定性帧渲染",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {},
  "main": "desktop/main.js",
  "scripts": {
    "doctor": "node scripts/doctor.js",
    "studio": "node scripts/studio.js",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "desktop:dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "desktop:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "desktop:win": "electron-builder --win --x64",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:ci": "node scripts/test_ci.js"
  },
  "build": {
    "appId": "com.pauloking.mgstudio",
    "productName": "MG Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "scripts/**/*",
      "templates/**/*",
      "medical/**/*",
      "tests/fixtures/mini-style-medical/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "identity": null
    },
    "dmg": {
      "title": "MG Studio 安装向导",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "axios": "^1.21.1",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.1",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
